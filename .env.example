# Environment variables for Teras UMKM Full-Stack App
# Copy this file to .env and configure with your credentials

# Prisma Database connection URL (PostgreSQL, MySQL, SQLite, etc.)
DATABASE_URL="postgresql://username:password@localhost:5432/teras_umkm?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/teras_umkm?schema=public"

# Supabase (Storage, Auth, Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Secret Key for token validation
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Local/Production URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Services (Maps, OAuth)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Komerce API (Sandbox Mode)
KOMERCE_SHIPPING_API_KEY="your-komerce-shipping-api-key"
KOMERCE_PAYMENT_API_KEY="your-komerce-payment-api-key"
KOMERCE_QRISLY_API_KEY="your-komerce-qrisly-api-key"
KOMERCE_BASE_URL="https://api-sandbox.collaborator.komerce.id"

# Midtrans Configuration (Sandbox)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_MERCHANT_ID="your-midtrans-merchant-id"
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Kirimi.id WhatsApp Gateway Configuration
KIRIMI_USER_CODE="your-kirimi-user-code"
KIRIMI_SECRET="your-kirimi-secret-key"
KIRIMI_DEVICE_ID="your-kirimi-device-id"

# Maileroo Email API (verifikasi email & notifikasi transaksional)
MAILEROO_API_KEY="your-maileroo-sending-key"
MAILEROO_FROM_ADDRESS="noreply@yourdomain.com"
MAILEROO_FROM_NAME="Saloka.id"

# Cloudflare R2 Storage (Optional - Free 10GB & $0 Egress/Bandwidth)
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="teras-umkm"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
