# Environment variables for Teras UMKM Full-Stack App
# Copy this file to .env and configure with your credentials

# Prisma Database connection URL (PostgreSQL, MySQL, SQLite, etc.)
DATABASE_URL="postgresql://username:password@localhost:5432/teras_umkm?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/teras_umkm?schema=public"

# Supabase (Storage, Auth, Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Secret Key for token validation
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Local/Production URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Services (Maps, OAuth)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"


# DOKU Payment Gateway (Jokul Checkout) — the only payment gateway.
#
# THIS FILE IS COMMITTED TO GIT (.gitignore ignores .env* but un-ignores this
# one), and it is never loaded at runtime — Next.js reads .env / .env.local.
# It is a template. Never put real credentials here: put them in .env for local
# development.
#
# FOR DEPLOYMENTS, THESE VARIABLES ARE THE FALLBACK, NOT THE USUAL PATH.
# Production credentials are configured in the admin CMS at
# /cms_admin/payment-gateway and stored encrypted in the database, so changing
# them (or flipping Sandbox↔Live) needs neither Vercel access nor a redeploy.
# The database row wins whenever it exists; these variables apply only until
# something is saved there, and again if an admin clears it. Requires
# JWT_SECRET, which is also the encryption key for the stored credentials.
#
# DOKU_IS_PRODUCTION is the sandbox/live switch: "true" points every DOKU call
# at https://api.doku.com, anything else at https://api-sandbox.doku.com. When
# it is "true", DOKU_CLIENT_ID and DOKU_SECRET_KEY must be the LIVE credentials
# — getDokuConfig() throws on startup rather than letting sandbox keys reach
# the production host. On Vercel, set the live values on the Production
# environment ONLY; preview deploys also run with NODE_ENV=production and would
# otherwise take real money.
#
# DOKU_PUBLIC_KEY verifies the RSA-SHA256 signature on incoming DOKU webhooks
# (src/lib/doku.ts verifyDokuNotification). It differs between sandbox and live,
# and there is no fallback — an unset key means webhooks are rejected.
DOKU_CLIENT_ID="your-doku-client-id"
DOKU_SECRET_KEY="your-doku-secret-key"
DOKU_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
DOKU_IS_PRODUCTION=false

# Biteship Shipping Aggregator. Live keys are prefixed "live_", sandbox "test_"
# — there is no separate flag. Without a key, shipping rates are estimated
# locally, which is fine in dev and refused (503) in production.
#
# Cart online payment is gated off until this key is set — see
# ONLINE_CART_PAYMENT_ENABLED in src/app/cart/page.tsx. A cart total includes a
# real shipping fee, so a delivery checkout with no rate source would send the
# buyer to DOKU and then dead-end. Community payments and wallet top-up carry no
# shipping and are unaffected.
BITESHIP_API_KEY="your-biteship-api-key"
BITESHIP_BASE_URL="https://api.biteship.com/v1"

# Which gateway src/lib/payment-gateway.ts routes join-fee/savings/coin-topup
# checkouts through. DOKU is the only adapter; this stays as the seam for
# moving to a future vendor once one is added to payment-gateway.ts.
PAYMENT_GATEWAY_PRIMARY=DOKU

# Kirimi.id WhatsApp Gateway Configuration
KIRIMI_USER_CODE="your-kirimi-user-code"
KIRIMI_SECRET="your-kirimi-secret-key"
KIRIMI_DEVICE_ID="your-kirimi-device-id"

# Maileroo Email API (verifikasi email & notifikasi transaksional)
MAILEROO_API_KEY="your-maileroo-sending-key"
MAILEROO_FROM_ADDRESS="noreply@yourdomain.com"
MAILEROO_FROM_NAME="Saloka.id"

# Cloudflare R2 Storage (Optional - Free 10GB & $0 Egress/Bandwidth)
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="teras-umkm"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Set to "1" ONLY if Cloudflare is verified to be the actual entry point for
# this deployment (check: `curl -sI https://<domain> | grep -i server` shows
# `server: cloudflare`). When set, src/lib/rate-limit.ts trusts the
# cf-connecting-ip header for IP-based rate limiting; otherwise it falls back
# to Vercel's own x-real-ip. Never set this for a deployment a client can
# reach directly (unproxied) — the header is client-spoofable in that case.
TRUST_CLOUDFLARE_IP=
